# Yalnızca sunucuyla (node dashboard/server.mjs) kullanılır; CSV ile panel.html için gerekmez.
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env git'e GİRMEZ (anahtarlar gizli kalır).

# ---------- Meta (Facebook) reklam verileri ----------
# Token: business.facebook.com → İşletme ayarları → Sistem kullanıcıları → Token oluştur (izin: ads_read).
META_ACCESS_TOKEN=
# Reklam hesabı kimliği: Ads Manager adres çubuğundaki act=XXXXXXXX (başına act_ eklemeseniz de olur)
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0

# ---------- Firebase (Google Analytics) ----------
# Servis hesabı anahtarı: Firebase → Project settings → Service accounts → Generate new private key. Repo DIŞINDA tutun.
# Servis hesabı e-postası Google Analytics → Admin → Property access management'ta Viewer olmalı, Google Analytics Data API açık olmalı.
FIREBASE_KEY_FILE=~/.config/landflow/firebase-key.json
# Özellik kimliği (sayı): Google Analytics adres çubuğundaki /p<ID>/ ya da Admin → Property details
FIREBASE_PROPERTY_ID=

# ---------- GameAnalytics ----------
# Metrics API anahtarı: GameAnalytics → Organization settings. Yalnızca PipelineIQ planında var, AnalyticsIQ Pro'da YOK.
# Oyundaki game key / secret key bu iş için KULLANILMAZ, onlar sadece veri göndermek içindir.
# Free ya da AnalyticsIQ Pro kullanıyorsanız bunları boş bırakıp CSV'leri panele sürükleyin (README → "GameAnalytics CSV").
GA_API_KEY=
# Oyun kimliği (sayı): GA panelinde oyunu açınca adres çubuğundaki /game/<ID>/
GA_GAME_ID=

# ---------- Sunucu ----------
PORT=5173
CACHE_MINUTES=10
