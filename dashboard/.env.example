# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env git'e GİRMEZ (anahtarlar gizli kalır).
# Bir kaynak boş bırakılırsa panel o kısım için ÖRNEK VERİ gösterir.

# ---------- Meta (Facebook) reklam verileri ----------
# Token: business.facebook.com → İşletme ayarları → Sistem kullanıcıları → Token oluştur
#        (uygulama: Land Flow, izin: ads_read). Süresiz token için sistem kullanıcısı önerilir.
META_ACCESS_TOKEN=
# Reklam hesabı kimliği: Ads Manager adres çubuğundaki act=XXXXXXXX (başına act_ eklemeseniz de olur)
META_AD_ACCOUNT_ID=
# Reklam hesabının para birimi (USD, TRY, EUR…)
META_CURRENCY=USD
META_API_VERSION=v21.0

# ---------- GameAnalytics ----------
# Metrics API anahtarı: GameAnalytics → Organization settings → Metrics API (Pro abonelik gerekir).
# NOT: Oyundaki game key / secret key bu iş için KULLANILMAZ, onlar sadece veri göndermek içindir.
GA_API_KEY=
# Oyun kimliği (sayı): GA panelinde oyunu açınca adres çubuğundaki /game/<ID>/
GA_GAME_ID=

# İsteğe bağlı: GA metrik adları / bölme alanları farklıysa buradan değiştirin.
# Desteklenen adları görmek için: http://localhost:5173/api/ga/metrics
# GA_METRIC_NEW_USERS=new_users
# GA_METRIC_DAU=user_unique
# GA_METRIC_SESSIONS=session_count
# GA_METRIC_SESSION_LENGTH=session_length
# GA_METRIC_RETENTION=retention_retro
# GA_RETENTION_SPLIT=retention_day
# GA_METRIC_PROGRESSION=progression_count
# GA_PROGRESSION_SPLIT=progression01,progression02,progression_status
# GA_METRIC_DESIGN=design_count
# GA_DESIGN_SPLIT=event_id

# ---------- Sunucu ----------
PORT=5173
# Aynı ağdaki başka cihazlardan (telefon vb.) açmak için 0.0.0.0 yapın
HOST=127.0.0.1
CACHE_MINUTES=10
