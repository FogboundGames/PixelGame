.studio {
    --bg: #1f2125;
    --panel: #26282d;
    --panel-2: #2e3137;
    --line: #3a3e45;
    --text: #d9dbe0;
    --muted: #979ba3;
    --accent: #5aa9f0;
    --critical: #e5534b;
    --warning: #e0a63a;
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
}

.studio__body { flex-direction: row; flex-grow: 1; min-height: 0; }
.studio__center { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.toolbar { flex-direction: row; align-items: center; height: 34px; padding: 0 10px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.toolbar__title { -unity-font-style: bold; font-size: 13px; }
.toolbar__state { margin-left: 12px; color: var(--muted); }
.toolbar__state--dirty { color: var(--warning); }
.toolbar__summary { margin-right: 10px; color: var(--muted); }
.toolbar__summary--bad { color: var(--critical); -unity-font-style: bold; }

.levels { width: 240px; flex-shrink: 0; background-color: var(--panel); border-right-width: 1px; border-color: var(--line); padding: 6px 0 0 0; }
.level-row { flex-direction: row; align-items: center; height: 44px; padding: 0 8px; }
.level-row__thumb { width: 36px; height: 36px; margin-right: 8px; flex-shrink: 0; }
.level-row__title { -unity-font-style: bold; }
.level-row__sub { color: var(--muted); font-size: 11px; }

.palette { flex-direction: row; flex-wrap: wrap; padding: 6px 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.chip { flex-direction: row; align-items: center; height: 24px; margin: 2px 4px 2px 0; padding: 0 8px 0 6px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 4px; color: var(--text); }
.chip--active { border-color: var(--accent); border-width: 2px; }
.chip--short { color: #ff8f88; }
.chip--over { color: #8cc4ff; }
.swatch { width: 14px; height: 14px; margin-right: 6px; border-radius: 3px; border-width: 1px; border-color: rgba(255, 255, 255, 0.25); flex-shrink: 0; }

.board { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.board__scroll { flex-grow: 1; }
.board__grid { padding: 8px 10px 16px 10px; align-self: flex-start; }
.board__row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.board__row-label { width: 28px; color: var(--muted); font-size: 11px; }
.board__column-title { width: 88px; margin-right: 8px; -unity-text-align: middle-center; color: var(--muted); font-size: 11px; }
.board__divider { margin: 2px 0 10px 28px; padding-top: 4px; border-top-width: 1px; border-color: var(--line); color: var(--muted); font-size: 10px; }
.board__ropes { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.card { width: 88px; height: 56px; margin-right: 8px; border-radius: 6px; border-width: 2px; border-color: rgba(0, 0, 0, 0.35); overflow: hidden; flex-shrink: 0; }
.card__fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; }
.card__number { position: absolute; left: 5px; top: 2px; font-size: 10px; }
.card__capacity { position: absolute; left: 0; right: 0; top: 16px; -unity-text-align: middle-center; font-size: 19px; -unity-font-style: bold; }
.card__marks { position: absolute; right: 3px; top: 3px; flex-direction: row; }
.card__mark { width: 14px; height: 14px; margin-left: 2px; -unity-text-align: middle-center; font-size: 9px; -unity-font-style: bold; color: white; background-color: rgba(10, 12, 20, 0.8); border-radius: 3px; padding: 0; }
.card--empty { background-color: transparent; border-color: var(--line); align-items: center; justify-content: center; color: var(--muted); }
.card--empty:hover { border-color: var(--accent); }
.card:hover { border-color: rgba(255, 255, 255, 0.5); }
.card--warning { border-color: var(--warning); }
.card--critical { border-color: var(--critical); }
.card--selected { border-color: white; }
.card--link-target { border-color: #ffd14d; }
.card--drop { border-color: var(--accent); }
.card--ghost { position: absolute; opacity: 0.85; margin: 0; }

.inspector { flex-grow: 1; padding: 10px; }
.inspector__title { font-size: 14px; -unity-font-style: bold; }
.inspector__sub { color: var(--muted); margin-bottom: 8px; }
.inspector__hint { color: var(--muted); white-space: normal; margin-top: 8px; }
.inspector__row { flex-direction: row; align-items: center; margin: 2px 0; }
.inspector__row-label { width: 74px; flex-shrink: 0; }
.inspector__action { margin: 6px 0 0 0; height: 24px; }
.inspector__danger { color: #ff8f88; }

.issues { height: 110px; flex-shrink: 0; padding: 4px 8px; background-color: var(--panel); border-top-width: 1px; border-color: var(--line); }
.issue { flex-direction: row; align-items: flex-start; padding: 2px 0; }
.issue:hover { background-color: var(--panel-2); }
.issue__tag { width: 52px; flex-shrink: 0; font-size: 10px; -unity-font-style: bold; }
.issue--critical .issue__tag { color: var(--critical); }
.issue--warning .issue__tag { color: var(--warning); }
.issue--info .issue__tag { color: var(--muted); }
.issue__text { white-space: normal; flex-shrink: 1; }

.inspector .unity-base-field { margin: 2px 0; }
.inspector .unity-base-field__label { min-width: 74px; width: 74px; }
.chip Label { margin: 0; padding: 0; }

.mode { height: 22px; margin: 0; padding: 0 10px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-radius: 0; color: var(--muted); }
.mode--active { background-color: var(--accent); color: #101216; -unity-font-style: bold; }
.toolbar > Button:last-child { margin-left: 10px; }

.preview { flex-direction: row; align-items: center; padding: 6px 10px; background-color: #1c3147; border-bottom-width: 1px; border-color: var(--accent); flex-shrink: 0; }
.preview__title { -unity-font-style: bold; }
.preview__detail { white-space: normal; color: var(--text); }
.preview__apply { background-color: var(--accent); color: #101216; -unity-font-style: bold; }
.card--moved { border-color: var(--accent); border-width: 3px; }

.studio__page { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.tab { height: 24px; margin: 0 0 0 0; padding: 0 12px; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-color: transparent; border-radius: 0; color: var(--muted); }
.tab--active { color: var(--text); border-color: var(--accent); -unity-font-style: bold; }
.toolbar__state { min-width: 100px; margin-right: 14px; }

.analysis { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 10px; }
.analysis__head { flex-direction: row; align-items: center; flex-shrink: 0; }
.analysis__title { font-size: 14px; -unity-font-style: bold; }
.analysis__note { color: var(--muted); white-space: normal; }
.analysis__progress { margin-top: 6px; padding: 4px 8px; background-color: #1c3147; border-radius: 4px; flex-shrink: 0; white-space: normal; }
.analysis__progress--bad { background-color: #452321; }
.analysis__filters { flex-direction: row; align-items: center; margin: 10px 0 6px 0; flex-shrink: 0; }
.analysis__filter { margin-left: 12px; }
.analysis__filter .unity-base-field__label { min-width: 0; width: auto; margin-right: 4px; }
.analysis__count { flex-grow: 1; -unity-text-align: middle-right; color: var(--muted); }
.analysis__table { flex-grow: 1; flex-shrink: 1; min-height: 80px; background-color: var(--panel); }
.cell--good { color: #6fd08c; }
.cell--warn { color: var(--warning); }
.cell--bad { color: var(--critical); -unity-font-style: bold; }

.metrics { flex-direction: row; margin-top: 10px; flex-shrink: 0; }
.metric { width: 240px; margin-right: 10px; padding: 8px 10px; background-color: var(--panel); border-radius: 6px; }
.metric__head { flex-direction: row; justify-content: space-between; align-items: center; }
.metric__value { font-size: 18px; -unity-font-style: bold; }
.metric__track { height: 8px; margin: 6px 0 4px 0; background-color: var(--panel-2); border-radius: 4px; }
.metric__band { position: absolute; top: 0; bottom: 0; background-color: #3f7d58; border-radius: 4px; }
.metric__marker { position: absolute; top: -3px; bottom: -3px; width: 3px; margin-left: -1px; background-color: white; }
.metric__target { color: var(--muted); font-size: 10px; }

.studio__side { width: 250px; flex-shrink: 0; background-color: var(--panel); border-left-width: 1px; border-color: var(--line); }
.level-preview { padding: 10px 10px 8px 10px; border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.level-preview__image { width: 230px; height: 230px; background-color: var(--bg); border-radius: 4px; }
.level-preview__caption { margin-top: 4px; color: var(--muted); font-size: 11px; -unity-text-align: middle-center; }

.automation { padding: 2px 8px 4px 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.automation .unity-foldout__content { margin-left: 0; }
.automation__cards { flex-direction: row; flex-wrap: wrap; }
.automation__card { width: 232px; margin: 2px 6px 4px 0; padding: 6px 8px; background-color: var(--panel-2); border-radius: 4px; }
.automation__title { -unity-font-style: bold; margin-bottom: 2px; }
.automation__state { color: var(--muted); font-size: 11px; margin-top: 2px; }
.automation__row { flex-direction: row; }
.automation__row Button { flex-grow: 1; flex-basis: 0; margin-left: 0; }
.automation__card Button { margin: 2px 0 0 0; height: 21px; }
.automation__row Button { margin-right: 3px; }
.automation__card .unity-base-field { margin: 1px 0; }
.automation__card .unity-base-field__label { min-width: 72px; width: 72px; }

.create-zone { padding: 4px 6px 6px 6px; border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.create-zone__drop { height: 28px; margin-bottom: 4px; -unity-text-align: middle-center; color: var(--accent); border-width: 1px; border-color: var(--accent); border-radius: 4px; background-color: rgba(90, 169, 240, 0.08); }
.create-zone Button { margin: 0 3px 0 0; }

.image-panel { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 10px; }
.image-panel__views { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 200px; }
.image-panel__view { flex-grow: 1; flex-basis: 0; margin-right: 10px; padding: 8px; background-color: var(--panel); border-radius: 6px; }
.image-panel__image { flex-grow: 1; min-height: 100px; background-color: var(--bg); border-radius: 4px; }
.image-panel__tools { flex-direction: row; flex-wrap: wrap; margin-top: 8px; flex-shrink: 0; }
.image-panel__strip { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.image-panel__chip { flex-direction: row; align-items: center; margin: 1px 8px 1px 0; }
.image-panel .preview { margin-top: 8px; border-radius: 4px; }
.image-panel .automation__card Button { margin: 2px 0 0 0; height: 21px; }
.image-panel .automation__card .unity-base-field__label { min-width: 72px; width: 72px; }
.image-panel .automation__row Button { margin-right: 3px; }

.canvas-panel { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.canvas-panel__tools { width: 150px; flex-shrink: 0; padding: 8px; background-color: var(--panel); border-right-width: 1px; border-color: var(--line); }
.canvas-panel__tools .unity-base-field { margin: 3px 0; }
.canvas-panel__tools .unity-base-field__label { min-width: 0; width: auto; flex-grow: 1; margin-right: 4px; }
.canvas-panel__tools .unity-base-slider__input { min-width: 30px; }
.canvas-tool { height: 26px; margin: 0 0 3px 0; -unity-text-align: middle-left; padding-left: 8px; }
.canvas-tool--active { background-color: var(--accent); color: #101216; -unity-font-style: bold; }
.canvas-panel__center { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.canvas-panel__top { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 4px 8px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); flex-shrink: 0; }
.canvas-panel__top Button { margin: 0 3px 0 0; height: 22px; }
.canvas-panel__top .unity-integer-field { width: 52px; margin: 0 4px 0 0; }
.canvas-panel__top .unity-integer-field .unity-base-field__label { min-width: 12px; width: 12px; }
.canvas-panel__top .unity-toggle { margin: 0 6px 0 6px; }
.canvas-panel__top .unity-toggle .unity-base-field__label { min-width: 0; width: auto; margin-right: 3px; }
.canvas-panel__hover { flex-grow: 1; -unity-text-align: middle-right; color: var(--muted); min-width: 110px; }
.canvas-surface { overflow: hidden; background-color: #17181b; flex-shrink: 1; min-height: 0; }
.canvas-surface__content { position: absolute; background-color: #6a6e78; }
.canvas-panel__side { width: 250px; flex-shrink: 0; padding: 10px; background-color: var(--panel); border-left-width: 1px; border-color: var(--line); }
.canvas-panel__thumb { width: 110px; height: 110px; align-self: center; background-color: var(--bg); border-radius: 4px; flex-shrink: 0; }
.canvas-panel__side Button { margin: 2px 2px 0 0; }
.canvas-color { flex-direction: row; align-items: center; padding: 3px 4px; border-radius: 3px; border-width: 1px; border-color: transparent; }
.canvas-color:hover { background-color: var(--panel-2); }
.canvas-color--active { border-color: var(--accent); background-color: var(--panel-2); }
.canvas-color--mismatch { color: #ff8f88; }
.canvas-warning { margin-top: 6px; padding: 4px 6px; background-color: #40331a; border-radius: 4px; flex-shrink: 0; }
